---
import config from '../data/site-config.json';
const { nom_entreprise, telephone } = config;
---
<header style="position: fixed; top: 0; left: 0; width: 100%; z-index: 100; padding: 16px 28px; display: flex; justify-content: space-between; align-items: center; background: linear-gradient(to bottom, rgba(11,17,20,0.95) 0%, rgba(11,17,20,0) 100%); backdrop-filter: blur(8px);">
  <div style="display: flex; align-items: center; gap: 12px;">
    <span style="width: 38px; height: 38px; border-radius: var(--radius); border: 1px solid var(--border-light); background: rgba(255, 255, 255, 0.05); display: flex; align-items: center; justify-content: center; color: var(--primary-cyan);">
      <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
    </span>
    <span class="serif" style="font-weight: 700; font-size: 1.25rem; color: #FFFFFF;">{nom_entreprise}</span>
  </div>
  <div style="display: flex; align-items: center; gap: 16px;">
    <a href={`tel:${telephone}`} style="display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: #FFFFFF; font-size: 0.92rem; text-decoration: none;">
      <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
      <span>{telephone}</span>
    </a>
    <a href="#contact" style="background: var(--accent-orange); color: #fff; padding: 10px 20px; font-weight: 600; font-size: 0.85rem; text-decoration: none; border-radius: var(--radius);">Devis Gratuit</a>
  </div>
</header>
