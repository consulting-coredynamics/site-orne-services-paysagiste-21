---
import config from '../data/site-config.json';

const { nom_entreprise, metier, ville, telephone, courriel, palette_couleurs, textes_optimises } = config;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "name": nom_entreprise,
  "image": "/assets/desktop/frame_0001.webp",
  "telephone": telephone,
  "email": courriel,
  "priceRange": "€€",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": ville,
    "addressCountry": "FR"
  },
  "areaServed": [ville, `Secteur ${ville} et 30 km aux alentours`],
  "openingHours": "Mo-Fr 08:00-19:00, Sa 08:00-12:00",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "24",
    "bestRating": "5",
    "worstRating": "1"
  }
};
---

<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <meta name="theme-color" content={palette_couleurs.background}>

  <title>{nom_entreprise} | {metier} à {ville} (Devis Gratuit)</title>
  <meta name="description" content={`Besoin d'un artisan ${metier} d'exception à ${ville} ? ${nom_entreprise} intervient pour vos travaux. Devis gratuit sous 24h.`}>
  <meta name="robots" content="index, follow">
  <meta name="author" content={nom_entreprise}>
  <meta name="geo.placename" content={`${ville}, France`}>
  <meta name="geo.region" content="FR">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content={`${nom_entreprise} | ${metier} à ${ville}`}>
  <meta property="og:description" content={`Découvrez le savoir-faire de ${nom_entreprise} à ${ville}. Garantie Décennale & RC Pro.`}>
  <meta property="og:image" content="/assets/desktop/frame_0001.webp">
  <meta property="og:locale" content="fr_FR">

  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛠️</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="image" href="/assets/desktop/frame_0001.webp" type="image/webp">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Roboto+Mono:wght@400;500;600&family=Zilla+Slab:wght@600;700&display=swap" rel="stylesheet">

  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

  <style define:vars={{
    bgDark: palette_couleurs.background || '#0B1114',
    cardSurface: palette_couleurs.surface || 'rgba(255, 255, 255, 0.035)',
    primaryCyan: palette_couleurs.primary || '#38BDF8',
    accentOrange: palette_couleurs.accent || '#FF6B2B'
  }}>
    :root {
      --bg-dark: var(--bgDark);
      --card-surface: var(--cardSurface);
      --border-light: rgba(255, 255, 255, 0.18);
      --border-glow: rgba(56, 189, 248, 0.35);
      --primary-cyan: var(--primaryCyan);
      --accent-orange: var(--accentOrange);
      --accent-orange-hover: var(--accentOrange);
      --text-main: #FFFFFF;
      --text-muted: #E2E8F0;
      --radius: 8px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    html, body {
      overflow-x: clip;
      width: 100%;
      min-height: 100%;
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: 'Inter', sans-serif;
      -webkit-font-smoothing: antialiased;
      line-height: 1.6;
    }
    .mono { font-family: 'Roboto Mono', monospace; }
    .serif { font-family: 'Zilla Slab', serif; }
  </style>
</head>
<body>
  <slot />
</body>
</html>
